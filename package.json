{
  "name": "@nxmxbbd/bamboozle",
  "version": "0.2.0",
  "description": "LAN-only Apple Home bridge for Bambu Lab 3D printers. No cloud, no Home Assistant, no Homebridge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxmxbbd/bamboozle.git"
  },
  "homepage": "https://github.com/nxmxbbd/bamboozle#readme",
  "bugs": {
    "url": "https://github.com/nxmxbbd/bamboozle/issues"
  },
  "keywords": [
    "homekit",
    "apple-home",
    "bambu-lab",
    "3d-printer",
    "hap-nodejs",
    "camera"
  ],
  "type": "module",
  "bin": {
    "bamboozle": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18 || ^24 || ^26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "hap-controller": "^0.10.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@homebridge/hap-nodejs": "^2.2.3",
    "mqtt": "^5.16.1",
    "uqr": "^0.1.3"
  }
}
